{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      ".env.*": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git clean*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "Get-Content .env*": "deny",
      "cat .env*": "deny",
      "type .env*": "deny",
      "printenv*": "deny",
      "Remove-Item *": "deny",
      "rm *": "deny"
    }
  }
}
