{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smillick-org",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "smillick.org/*",
      "zone_name": "smillick.org"
    }
  ],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
