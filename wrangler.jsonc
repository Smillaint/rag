{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smillick-org",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "smillick.org/*",
      "zone_name": "smillick.org"
    }
  ],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "RAG_ORIGIN_URL": "https://rag.smillick.org"
  },
  "ratelimits": [
    {
      "name": "RAG_API_RATE_LIMITER",
      "namespace_id": "60601",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RAG_ASK_RATE_LIMITER",
      "namespace_id": "60602",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
